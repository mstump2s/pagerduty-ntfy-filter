{
  "manifest_version": 3,
  "name": "PD-Filter",
  "version": "1.2",
  "description": "Kompakte Ansicht des lokalen PagerDuty-Filters; Icon blinkt bei lauten Alarmen deiner Kunden. Spiegelt die shifts-Uebersicht nach pd-filter.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "PD-Filter", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms"],
  "host_permissions": ["http://localhost:8790/*", "https://shifts.csoc.gk.rocks/*"],
  "content_scripts": [
    {
      "matches": ["https://shifts.csoc.gk.rocks/*"],
      "js": ["shifts_content.js"],
      "run_at": "document_idle"
    }
  ]
}
