# Einstellungen fuer pd_filter.py (KEY=wert, eine pro Zeile).
# Kopieren nach config.env und ausfuellen. Umgebungsvariablen haben Vorrang.

# Persoenlicher PagerDuty-API-Key (My Profile -> User Settings -> API Access)
PD_API_TOKEN=DEIN_PAGERDUTY_API_KEY

# Nur fuer Account-API-Keys noetig (fuer den Ack-Button): deine PagerDuty-E-Mail
PD_FROM_EMAIL=

# Optional: nur diese PagerDuty-Services abfragen (IDs, kommagetrennt)
PD_SERVICE_IDS=

# Dein ntfy-Topic (schwer erratbaren Namen waehlen und in der ntfy-App abonnieren)
NTFY_TOPIC=DEIN_GEHEIMES_TOPIC
# Optional: eigenes Topic fuer leise Mitteilungen (leer = gleiches Topic)
NTFY_TOPIC_SILENT=
# Optional: eigener ntfy-Server (z.B. auf dem Pi per Tailscale: https://pi.DEIN-TAILNET.ts.net)
NTFY_SERVER=https://ntfy.sh
# Optional: Ersatz, falls NTFY_SERVER nicht erreichbar ist (gleiches Topic dort auch abonnieren)
NTFY_FALLBACK_SERVER=
# Kunde, Titel und Service in der Mitteilung zeigen (nur eigener Server, nie ntfy.sh oder Ersatz)
NTFY_DETAILS=false

# Laut nur, wenn der Service-Name diesen Text enthaelt (leer = alle Services)
# Mehrere mit ; trennen, z.B. CSOC (High);Anderer Service
SERVICE_FILTER=CSOC (High)

# Leise Mitteilung (ohne Ton) fuer:
#   kunden = deine Kunden, wenn der Service nicht passt
#   alle   = alle Incidents, die nicht laut sind
#   keine  = nur laute Alarme
SILENT_FOR=kunden

# Wie oft PagerDuty abgefragt wird (Sekunden)
POLL_SECONDS=30

# Optional: nur zu Arbeitszeiten aktiv (ausserhalb pausiert es, bleibt aber an)
ONLY_IN_WINDOW=false
START_HOUR=8
END_HOUR=18
WEEKDAYS_ONLY=true

# Optional: nur aktiv, solange du laut PagerDuty gerade in einem Schedule on-call bist
ONLY_ON_CALL=false
# PagerDuty-User (Name oder E-Mail) fuer den Button "On-Call ab jetzt uebergeben"
OVERRIDE_USER=CSOC Dummy

# LAS (Last Analyst Standing): Button in der Live-Ansicht schaltet die PagerDuty-Push-
# Benachrichtigungen bis zu dieser Uhrzeit an, danach entfernt der Filter sie wieder
LAS_END_HOUR=18
# Welche PagerDuty-Kontakte LAS / "Ohne Ende an" anschaltet (IDs, kommagetrennt, am einfachsten in der
# Live-Ansicht unter Einstellungen waehlen). Leer = alle Geraete mit PagerDuty-App
LAS_CONTACTS=
# Fuer welche Dringlichkeit: hoch | niedrig | beide
LAS_URGENCY=hoch

# Live-Ansicht im Browser (nur auf diesem Rechner). Nicht 8787, da laeuft wrangler.
WEB_PORT=8790

# Ack-Button in der ntfy-Mitteilung (nur ueber den eigenen NTFY_SERVER). Dafuer auf diesem Rechner einmal:
#   tailscale serve --bg --https=8443 http://127.0.0.1:8791
# und hier die Adresse eintragen, z.B. https://mein-mac.DEIN-TAILNET.ts.net:8443. Leer = kein Button.
# Der Schluessel ACK_SECRET wird beim Start automatisch hier angelegt.
PHONE_ACK_URL=
PHONE_ACK_PORT=8791
